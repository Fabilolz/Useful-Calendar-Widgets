<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/widget_background_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_bg_shape" android:contentDescription="@null"/>
<LinearLayout android:id="@+id/widget_content_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp">
<TextView android:id="@+id/widget_compact_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:visibility="gone"/>
<TextView android:id="@+id/widget_day_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VENERDÌ" android:textSize="11sp" android:textColor="#FF625D" android:includeFontPadding="false" android:letterSpacing="0.12" android:fontFamily="sans-serif-medium"/>
<LinearLayout android:id="@+id/widget_date_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="4dp">
<TextView android:id="@+id/widget_day_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textSize="58sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:fontFamily="sans-serif-light"/>
<TextView android:id="@+id/widget_day_subtext" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="novembre" android:textSize="14sp" android:textColor="#96969F" android:includeFontPadding="false" android:layout_marginStart="7dp" android:layout_marginBottom="6dp"/>
</LinearLayout>
<TextView android:id="@+id/widget_month_below" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
<TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:importantForAccessibility="no"/>
<FrameLayout android:id="@+id/widget_event_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
<ImageView android:id="@+id/widget_event_1_card_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_card_shape" android:contentDescription="@null"/>
<LinearLayout android:id="@+id/widget_event_1_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="10dp">
<ImageView android:id="@+id/widget_event_1_bar" android:layout_width="3dp" android:layout_height="match_parent" android:layout_marginEnd="9dp" android:src="@drawable/widget_pill_shape" android:contentDescription="@null"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/widget_event_1_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Evento" android:textSize="13sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"/>
<TextView android:id="@+id/widget_event_1_location" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luogo" android:textSize="11sp" android:textColor="#A4A4AC" android:includeFontPadding="false" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_event_1_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="16:30 – 17:30" android:textSize="12sp" android:textColor="#FF625D" android:includeFontPadding="false" android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout></LinearLayout></FrameLayout>
<FrameLayout android:id="@+id/widget_event_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
<ImageView android:id="@+id/widget_event_2_card_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_card_shape" android:contentDescription="@null"/>
<LinearLayout android:id="@+id/widget_event_2_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="10dp">
<ImageView android:id="@+id/widget_event_2_bar" android:layout_width="3dp" android:layout_height="match_parent" android:layout_marginEnd="9dp" android:src="@drawable/widget_pill_shape" android:contentDescription="@null"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/widget_event_2_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Evento" android:textSize="13sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"/>
<TextView android:id="@+id/widget_event_2_location" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luogo" android:textSize="11sp" android:textColor="#A4A4AC" android:includeFontPadding="false" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_event_2_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="16:30 – 17:30" android:textSize="12sp" android:textColor="#FF625D" android:includeFontPadding="false" android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout></LinearLayout></FrameLayout>
<FrameLayout android:id="@+id/widget_event_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
<ImageView android:id="@+id/widget_event_3_card_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_card_shape" android:contentDescription="@null"/>
<LinearLayout android:id="@+id/widget_event_3_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="10dp">
<ImageView android:id="@+id/widget_event_3_bar" android:layout_width="3dp" android:layout_height="match_parent" android:layout_marginEnd="9dp" android:src="@drawable/widget_pill_shape" android:contentDescription="@null"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/widget_event_3_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Evento" android:textSize="13sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"/>
<TextView android:id="@+id/widget_event_3_location" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luogo" android:textSize="11sp" android:textColor="#A4A4AC" android:includeFontPadding="false" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_event_3_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="16:30 – 17:30" android:textSize="12sp" android:textColor="#FF625D" android:includeFontPadding="false" android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout></LinearLayout></FrameLayout>
<LinearLayout android:id="@+id/widget_empty_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <FrameLayout android:id="@+id/widget_weather_temp_spacer" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:visibility="gone"/>
        <TextView android:id="@+id/widget_empty_weather_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif-thin"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_empty_weather_condition" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="start|center_vertical" android:orientation="horizontal">
        <FrameLayout android:id="@+id/widget_weather_condition_spacer" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:visibility="gone"/>
        <ImageView android:id="@+id/widget_empty_weather_inline_icon" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:visibility="gone"/>
        <TextView android:id="@+id/widget_empty_weather_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_weather_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="end" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
    <LinearLayout android:id="@+id/widget_weather_range" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/widget_weather_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:textSize="10sp"/>
        <ImageView android:id="@+id/widget_weather_track" android:layout_width="0dp" android:layout_weight="1" android:layout_height="12dp" android:layout_marginHorizontal="18dp" android:scaleType="fitXY" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/widget_weather_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:textSize="10sp" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</LinearLayout>
<TextView android:id="@+id/widget_empty_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#96969F" android:includeFontPadding="false" android:visibility="gone"/>
</LinearLayout>
<ImageView android:id="@+id/widget_empty_weather_symbol" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="top|end" android:layout_marginTop="20dp" android:layout_marginEnd="20dp" android:contentDescription="@null" android:visibility="gone"/>
<include layout="@layout/widget_inline_weather" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="18dp" android:layout_marginEnd="15.5dp"/>
<TextView android:id="@+id/widget_more_events" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="18dp" android:layout_marginEnd="18dp" android:includeFontPadding="false" android:maxLines="1" android:visibility="gone"/>
</FrameLayout>
