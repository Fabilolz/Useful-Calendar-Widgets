<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_week_event_card"
    android:layout_width="match_parent"
    android:layout_height="37dp">

    <ImageView
        android:id="@+id/widget_week_event_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_shape" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:layout_gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/widget_week_event_bar"
            android:layout_width="3dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_pill_shape" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_week_event_title" android:includeFontPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Yoga Class"
                android:textColor="#FF80AB"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_week_event_time" android:includeFontPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:singleLine="true"
                android:text="4:00–5:00 PM • Golden Gate Park"
                android:textColor="#F48FB1"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_week_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>
</FrameLayout>
