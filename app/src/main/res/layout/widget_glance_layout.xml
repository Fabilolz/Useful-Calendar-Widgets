<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_glance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image supporting continuous 0-100% opacity and custom color filter -->
    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_shape" />

    <LinearLayout
        android:id="@+id/widget_glance_content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Date Bubble on the left -->
        <FrameLayout
            android:id="@+id/widget_glance_date_bubble"
            android:layout_width="52dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/widget_glance_date_bubble_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_card_shape" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_glance_day_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="FRI"
                    android:textAllCaps="true"
                    android:textColor="#FF5252"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_glance_day_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="30"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Info Column on the right -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Top row: UP NEXT + countdown badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_glance_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="UP NEXT"
                    android:textColor="#E040FB"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/widget_glance_badge_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/widget_glance_badge_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_pill_shape" />

                    <TextView
                        android:id="@+id/widget_glance_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:text="in 1h 30m"
                        android:textColor="#F48FB1"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Event Title -->
            <TextView
                android:id="@+id/widget_glance_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Yoga Class"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Subtitle: Time range & Location -->
            <TextView
                android:id="@+id/widget_glance_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:singleLine="true"
                android:text="4:00–5:00 PM • Golden Gate Park"
                android:textColor="#B0BEC5"
                android:textSize="11.5sp" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/widget_glance_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/all_clear_today"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
        <include layout="@layout/widget_inline_weather" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"/>
    </LinearLayout>
</FrameLayout>
